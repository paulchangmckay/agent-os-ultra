{
  "env": {
    "TRACE_TO_LANGSMITH": "true"
  },
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(pwd)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(openwolf:*)",
      "Bash(pm2 list)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(node:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(echo:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(pnpm:*)",
      "Write(/Users/paulmckay/.claude/.understand-anything/**)",
      "Edit(/Users/paulmckay/.claude/.understand-anything/**)"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/hooks/session-start.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/sg-python.sh\" \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/ensure_agent_sdk.py\"",
            "timeout": 180
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/hooks/plugin-health-check-gate.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/openwolf-cron-gate.js memory-consolidation \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 130
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/prune-token-ledger.js \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/Users/paulmckay/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/hooks/adhd-caveman.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/session-start-reset-read-state.js \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/user-prompt-submit.js\"",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/sg-python.sh\" \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/security_reminder_hook.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/pre-read-check.js"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/pre-skill-gate.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/pre-principles-injection.js"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/worktree-repo-guard.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/worktree-path-guard.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/cerebrum-write-guard.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/pre-tool-use.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/post-skill-record.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/post-write-batch-nudge.js"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/sg-python.sh\" \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/security_reminder_hook.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/post-bash-truncate.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/sg-python.sh\" \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "if": "Bash(git commit:*)",
            "asyncRewake": true,
            "rewakeMessage": "Background security review of commit — address or acknowledge the findings below, then continue with the user's original request or continue waiting for their reply:",
            "rewakeSummary": "Commit security review found issues"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/sg-python.sh\" \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "if": "Bash(git push:*)",
            "asyncRewake": true,
            "rewakeMessage": "Background security review of pushed commits not yet reviewed — address or acknowledge the findings below, then continue with the user's original request or continue waiting for their reply:",
            "rewakeSummary": "Push security review found issues"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ -f .wolf/anatomy.md ] && openwolf scan --check 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/cerebrum-write-guard-post.js"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/post-tool-use.js\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/post-read-failure-rescue.js"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/stop.js\"",
            "timeout": 120
          },
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Task complete\" with title \"Claude Code\" sound name \"Glass\"'",
            "async": true
          },
          {
            "type": "command",
            "command": "REPO=$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel 2>/dev/null); if [ -n \"$REPO\" ]; then STALE=$(git -C \"$REPO\" worktree list 2>/dev/null | tail -n +2); if [ -n \"$STALE\" ]; then echo \"⚠️  Active worktrees — run cleanup if merged:\\n$STALE\\n  Fix: git -C $REPO worktree remove <path> && git -C $REPO branch -d <branch>\"; fi; fi",
            "async": true
          },
          {
            "type": "command",
            "command": "REPO=$(git -C \"$CLAUDE_PROJECT_DIR\" rev-parse --show-toplevel 2>/dev/null); if [ -n \"$REPO\" ]; then STATE=\"$REPO/.wolf/_last-seen-head\"; CURRENT=$(git -C \"$REPO\" rev-parse HEAD 2>/dev/null); if [ -n \"$CURRENT\" ]; then if [ -f \"$STATE\" ]; then PREV=$(cat \"$STATE\"); if [ -n \"$PREV\" ] && [ \"$PREV\" != \"$CURRENT\" ]; then TOUCHED=$(git -C \"$REPO\" diff --name-only \"$PREV\" \"$CURRENT\" -- hooks/ settings.json 2>/dev/null); if [ -n \"$TOUCHED\" ]; then echo \"restart-needed: hooks/ or settings.json changed since last check —\\n$TOUCHED\"; fi; fi; fi; mkdir -p \"$REPO/.wolf\"; echo \"$CURRENT\" > \"$STATE\"; fi; fi",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/sg-python.sh\" \"$CLAUDE_PROJECT_DIR/plugins/marketplaces/claude-plugins-official/plugins/security-guidance/hooks/security_reminder_hook.py\"",
            "asyncRewake": true,
            "rewakeMessage": "Background security review feedback — address or acknowledge the findings below, then continue with the user's original request or continue waiting for their reply. This is supplementary, not a replacement for your previous response:",
            "rewakeSummary": "Background security review found issues"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/openwolf-cron-gate.js cerebrum-reflection \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 130
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/stop-failure.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/subagent-thin-harness.js"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/subagent-stop.js\"",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/hooks/pre-compact-snapshot.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/pre-compact.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/hooks/post-compact-anatomy.sh"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/hooks/post-compact-observation.js"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/post-compact.js\"",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/langsmith-plugin/bundle/session-end.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "understand-anything@understand-anything": true,
    "claude-plugins-official@security-guidance": true,
    "claude-plugins-official@skill-creator": true,
    "claude-plugins-official@feature-dev": true,
    "claude-plugins-official@plugin-dev": true,
    "claude-plugins-official@ba-agent": true,
    "document-skills@anthropic-agent-skills": true,
    "context-mode@context-mode": true,
    "i-have-adhd@i-have-adhd": false,
    "superpowers@superpowers-dev": true,
    "neuroarxiv@neuroarxiv": true
  },
  "extraKnownMarketplaces": {
    "understand-anything": {
      "source": {
        "source": "github",
        "repo": "Egonex-AI/Understand-Anything"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    }
  },
  "autoUpdatesChannel": "latest",
  "theme": "dark-daltonized"
}
